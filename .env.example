# Database Configuration
# ------------------------------------------------------------------------------
# Production (Neon PostgreSQL — recommended for Vercel deployment)
DATABASE_URL="postgresql://user:password@ep-cool-cloud-123456.us-east-2.aws.neon.tech/readmeforge?sslmode=require"

# Local Development (SQLite fallback)
# DATABASE_URL="file:./dev.db"
# (Note: set provider = "sqlite" in prisma/schema.prisma when using file:./dev.db)

# AI Engine
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"

# GitHub OAuth & Push Automation
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_TOKEN="optional-personal-access-token-for-higher-rate-limits"

# NextAuth Security
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional Cloud Media Storage
# ------------------------------------------------------------------------------
CLOUDINARY_URL="your-cloudinary-url"
