# Database Configuration
# ------------------------------------------------------------------------------
# Option A: Local Development (SQLite) — Default
DATABASE_URL="file:./dev.db"

# Option B: Production (PostgreSQL — Neon, Supabase, Railway)
# (Remember to change provider = "postgresql" in prisma/schema.prisma)
# DATABASE_URL="postgresql://user:password@host:5432/readmeforge?sslmode=require"

# AI Engine
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"

# GitHub OAuth & Push Automation
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_TOKEN="optional-personal-access-token-for-higher-rate-limits"

# NextAuth Security
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional Cloud Media Storage
# ------------------------------------------------------------------------------
CLOUDINARY_URL="your-cloudinary-url"
